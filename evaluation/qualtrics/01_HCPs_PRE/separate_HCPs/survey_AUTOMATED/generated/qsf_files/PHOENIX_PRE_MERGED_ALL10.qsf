    {
      "SurveyID": "SV_11C1E21A508709B",
      "Element": "SQ",
      "PrimaryAttribute": "QID57",
      "SecondaryAttribute": "PHOENIX evaluatiestudieFase 1 &#8212; onafhankelijke expertgeneratieInstrument voor ZorgprofessionalsUw toegewezen casus",
      "TertiaryAttribute": null,
      "Payload": {
        "Type": "DB",
