    {
      "SurveyID": "SV_11C1E21A508709B",
      "Element": "SQ",
      "PrimaryAttribute": "QID129",
      "SecondaryAttribute": "Casus C06: 32-jarige marketingprofessional &nbsp;|&nbsp; Duur: 2 jaar\"Zo'n twee jaar geleden begon ik toenemende spannin",
      "TertiaryAttribute": null,
      "Payload": {
        "Type": "DB",
        "Selector": "TB",
        "SubSelector": "TX",
        "DataExportTag": "C06_D1_CASUS",
        "QuestionText": "<div style=\"background:#EFF6FF;border:2px solid #1D4ED8;border-radius:6px;padding:14px 18px;margin:10px 0;\"><div style=\"font-weight:bold;color:#1D4ED8;margin-bottom:8px;font-size:13px;\">Casus C06: 32-jarige marketingprofessional &nbsp;|&nbsp; Duur: 2 jaar</div><div style=\"font-size:13px;line-height:1.65;color:#1E293B;\"><p style=\"font-style:italic;font-size:13px;\">\"Zo'n twee jaar geleden begon ik toenemende spanning te ervaren in werkgerelateerde situaties waarbij ik zichtbaar ben of beoordeeld word. Voor elke vergadering of presentatie bereid ik mij buitensporig lang voor – soms meerdere uren – uit angst niet competent over te komen. Na afloop piekeren mijn gedachten urenlang over wat ik verkeerd gezegd of gedaan heb. Ik vermijd inmiddels actief kansen waarbij ik mij moet presenteren: ik neem nauwelijks het woord in vergaderingen, wijs leiderschapsrollen af en aarzel bij elke professionele zichtbaarheidsmogelijkheid. Mijn loopbaan lijdt hieronder: ik heb een promotie afgeslagen omdat ik de extra zichtbaarheid niet aankon.\"</p></div></div><p style=\"margin:5px 0;\"><strong>Opdracht:</strong> noteer <strong>2–6 symptoomlabels</strong> voor deze casus. Gebruik enkel korte labels (2–5 woorden); voeg geen beschrijving toe. Laat ongebruikte velden leeg.</p>",
        "QuestionDescription": "Casus C06: 32-jarige marketingprofessional &nbsp;|&nbsp; Duur: 2 jaar\"Zo'n twee jaar geleden begon ik toenemende spannin",
        "ChoiceOrder": [],
        "Choices": {},
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 1,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"background:#EFF6FF;border:2px solid #1D4ED8;border-radius:6px;padding:14px 18px;margin:10px 0;\"><div style=\"font-weight:bold;color:#1D4ED8;margin-bottom:8px;font-size:13px;\">Casus C06: 32-jarige marketingprofessional &nbsp;|&nbsp; Duur: 2 jaar</div><div style=\"font-size:13px;line-height:1.65;color:#1E293B;\"><p style=\"font-style:italic;font-size:13px;\">\"Zo'n twee jaar geleden begon ik toenemende spanning te ervaren in werkgerelateerde situaties waarbij ik zichtbaar ben of beoordeeld word. Voor elke vergadering of presentatie bereid ik mij buitensporig lang voor – soms meerdere uren – uit angst niet competent over te komen. Na afloop piekeren mijn gedachten urenlang over wat ik verkeerd gezegd of gedaan heb. Ik vermijd inmiddels actief kansen waarbij ik mij moet presenteren: ik neem nauwelijks het woord in vergaderingen, wijs leiderschapsrollen af en aarzel bij elke professionele zichtbaarheidsmogelijkheid. Mijn loopbaan lijdt hieronder: ik heb een promotie afgeslagen omdat ik de extra zichtbaarheid niet aankon.\"</p></div></div><p style=\"margin:5px 0;\"><strong>Opdracht:</strong> noteer <strong>2–6 symptoomlabels</strong> voor deze casus. Gebruik enkel korte labels (2–5 woorden); voeg geen beschrijving toe. Laat ongebruikte velden leeg.</p>",
