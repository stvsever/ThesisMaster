    {
      "SurveyID": "SV_11C1E21A508709B",
      "Element": "SQ",
      "PrimaryAttribute": "QID37",
      "SecondaryAttribute": "Casus C02: 34-jarige administratief medewerker in de zorg &nbsp;|&nbsp; Duur: 3 maanden\"Ongeveer drie maanden geleden be",
      "TertiaryAttribute": null,
      "Payload": {
        "Type": "DB",
        "Selector": "TB",
        "SubSelector": "TX",
        "DataExportTag": "C02_D1_CASUS",
        "QuestionText": "<div style=\"background:#EFF6FF;border:2px solid #1D4ED8;border-radius:6px;padding:14px 18px;margin:10px 0;\"><div style=\"font-weight:bold;color:#1D4ED8;margin-bottom:8px;font-size:13px;\">Casus C02: 34-jarige administratief medewerker in de zorg &nbsp;|&nbsp; Duur: 3 maanden</div><div style=\"font-size:13px;line-height:1.65;color:#1E293B;\"><p style=\"font-style:italic;font-size:13px;\">\"Ongeveer drie maanden geleden begon ik plots episodes te krijgen waarbij mijn hart tekeergaat, ik het gevoel heb dat ik geen lucht krijg en ik er zeker van ben dat er iets ernstig misloopt. Die episodes zijn heel beangstigend en kunnen zelfs optreden wanneer ik thuis rustig neerzit. Sindsdien ben ik bang geworden om zo'n episode in het openbaar te krijgen en vermijd ik supermarkten, openbaar vervoer en drukke plaatsen. Ik heb mij al meerdere keren ziek gemeld omdat ik bang was dat het op het werk zou gebeuren. Ik weet rationeel dat die situaties niet gevaarlijk zijn, maar de angst blijft overheersen.\"</p></div></div><p style=\"margin:5px 0;\"><strong>Opdracht:</strong> noteer <strong>2–6 symptoomlabels</strong> voor deze casus. Gebruik enkel korte labels (2–5 woorden); voeg geen beschrijving toe. Laat ongebruikte velden leeg.</p>",
        "QuestionDescription": "Casus C02: 34-jarige administratief medewerker in de zorg &nbsp;|&nbsp; Duur: 3 maanden\"Ongeveer drie maanden geleden be",
        "ChoiceOrder": [],
        "Choices": {},
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 1,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"background:#EFF6FF;border:2px solid #1D4ED8;border-radius:6px;padding:14px 18px;margin:10px 0;\"><div style=\"font-weight:bold;color:#1D4ED8;margin-bottom:8px;font-size:13px;\">Casus C02: 34-jarige administratief medewerker in de zorg &nbsp;|&nbsp; Duur: 3 maanden</div><div style=\"font-size:13px;line-height:1.65;color:#1E293B;\"><p style=\"font-style:italic;font-size:13px;\">\"Ongeveer drie maanden geleden begon ik plots episodes te krijgen waarbij mijn hart tekeergaat, ik het gevoel heb dat ik geen lucht krijg en ik er zeker van ben dat er iets ernstig misloopt. Die episodes zijn heel beangstigend en kunnen zelfs optreden wanneer ik thuis rustig neerzit. Sindsdien ben ik bang geworden om zo'n episode in het openbaar te krijgen en vermijd ik supermarkten, openbaar vervoer en drukke plaatsen. Ik heb mij al meerdere keren ziek gemeld omdat ik bang was dat het op het werk zou gebeuren. Ik weet rationeel dat die situaties niet gevaarlijk zijn, maar de angst blijft overheersen.\"</p></div></div><p style=\"margin:5px 0;\"><strong>Opdracht:</strong> noteer <strong>2–6 symptoomlabels</strong> voor deze casus. Gebruik enkel korte labels (2–5 woorden); voeg geen beschrijving toe. Laat ongebruikte velden leeg.</p>",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionID": "QID37"
      }
    },
